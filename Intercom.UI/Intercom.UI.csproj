<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Intercom.UI</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>
        <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
        <ApplicationTitle>Rider Intercom</ApplicationTitle>
        <ApplicationId>com.companyname.intercom.ui</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    </PropertyGroup>
    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#142123" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0C1416" BaseSize="128,128" />
        <MauiFont Include="Resources\Fonts\*" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <ProjectReference Include="..\Intercom.Domain\Intercom.Domain.csproj" />
        <ProjectReference Include="..\Intercom.Application\Intercom.Application.csproj" />
        <ProjectReference Include="..\Intercom.Infrastructure\Intercom.Infrastructure.csproj" />
        <ProjectReference Include="..\Intercom.Infrastructure.Android\Intercom.Infrastructure.Android.csproj" />
    </ItemGroup>
</Project>

