<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Intercom.UI.ViewModels"
             xmlns:views="clr-namespace:Intercom.UI.Views"
             x:Class="Intercom.UI.MainPage"
             x:DataType="vm:IntercomViewModel"
             SafeAreaEdges="Container"
             BackgroundColor="{StaticResource Canvas}">
    <Grid>
        <views:EasyConnectPage IsVisible="{Binding IsLobby}" />
        <views:IntercomSessionPage IsVisible="{Binding IsInSession}" />
    </Grid>
</ContentPage>

